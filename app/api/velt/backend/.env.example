# Django Velt Self-Hosting Backend — Environment Variables
# Copy to .env and fill in your values

# MongoDB Atlas (required)
VELT_MONGODB_CONNECTION_STRING="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority"
VELT_MONGODB_DATABASE=velt_comments

# Velt project credentials (from https://console.velt.dev)
VELT_API_KEY=
VELT_AUTH_TOKEN=

# resolver-endpoint-auth (Feature 1) — shared HS256 secret used BOTH by the resolver
# gate (sdk.selfHosting.verifyToken) and the dev-only /api/velt/auth/mint endpoint.
# LOCAL DEV ONLY. In production verify with an asymmetric key (JWKS) and a real IdP.
VELT_RESOLVER_JWT_SECRET=dev-resolver-secret

# AWS S3 (for attachment storage)
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# CORS — comma-separated, no trailing slashes, no spaces
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Django (optional in dev; set for prod)
# DJANGO_SECRET_KEY=
# DEBUG=False
